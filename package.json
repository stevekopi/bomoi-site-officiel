{
  "name": "bomoi-officiel-v2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "next dev",
    "build": "npm run package:iis",
    "build:iis": "npm run prepare:apk && node scripts/generate-build-info.mjs iis && tsc --noEmit -p tsconfig.iis.json && next build --webpack",
    "package:iis": "npm run build:iis && node scripts/package-iis.mjs",
    "start": "node scripts/start-iis.mjs",
    "test": "npm run build && node --experimental-strip-types --test tests/rendered-html.test.mjs tests/download-statistics.test.mjs tests/download-server.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "prepare:apk": "node scripts/prepare-apk.mjs",
    "build:sites": "node scripts/build-verified.mjs",
    "dev:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "start:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:iis": "node scripts/start-iis.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "i18next": "^25.5.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Bomoi — Site officiel"
}
